CREATE OR REPLACE FUNCTION           fn_crypt  (v_idx IN VARCHAR, v_indata IN VARCHAR, v_key IN VARCHAR)
RETURN VARCHAR IS
 v_return VARCHAR(100):=NULL;
 v_i   INT:=1;
 v_keylen INT:= LENGTH(v_key);
 v_tmp  INT:=0;
 v_result VARCHAR(100):=NULL;
 BEGIN
        IF ((v_indata = NULL) OR (v_indata = '')) then
          RETURN v_return;
          END IF;
     /*æœ≫￡≫≠*/
          IF (v_idx = '1') then
         BEGIN
           WHILE v_i <= LENGTH(v_indata)  LOOP
        BEGIN
        IF (MOD(v_keylen,v_i)= 0) then
        BEGIN
         v_tmp := ascii(SUBSTR(v_indata,v_i,1)) + ascii(SUBSTR(v_key, 1,1));
         v_result := v_result || CHR(FLOOR(v_tmp/100)+v_i) || CHR(MOD(v_tmp,100));
         v_i := v_i + 1;
        END;
        ELSE
        BEGIN
         v_tmp := ascii(SUBSTR(v_indata,v_i,1)) + ascii(SUBSTR(v_key, MOD(v_keylen,v_i) ,1));
         v_result := v_result || CHR(FLOOR(v_tmp/100)+v_i) || CHR(MOD(v_tmp,100));
         v_i := v_i + 1;
        END;
        END IF;
      END;
        END LOOP;
   /*∫π≫￡≫≠*/   END;
        ELSE
       BEGIN
           WHILE v_i <= LENGTH(v_indata) LOOP
        BEGIN
           IF (MOD(v_keylen,FLOOR((v_i+1)/2)) = 0) then
        BEGIN
         v_result := v_result || CHR((ascii(SUBSTR(v_indata,v_i,1))-FLOOR((v_i+1)/2))*100 + ascii(SUBSTR(v_indata,v_i+1,1)) - ascii(SUBSTR(v_key, 1 ,1)));
         v_i := v_i+2;
        END;
        ELSE
        BEGIN
         v_result := v_result || CHR((ascii(SUBSTR(v_indata,v_i,1))-FLOOR((v_i+1)/2))*100 + ascii(SUBSTR(v_indata,v_i+1,1)) - ascii(SUBSTR(v_key,  MOD(v_keylen,FLOOR((v_i+1)/2)),1)));
         v_i := v_i+2;
        END;
        END IF;
      END;
        END LOOP;
       END;
        END IF;
  RETURN v_result;
END FN_crypt; 


CREATE OR REPLACE FUNCTION           FN_TIMEGAP (V_DATETIME IN VARCHAR)
RETURN VARCHAR
IS 
N_RETURN INT := -1 ;
DT_DATE DATE := NULL ;
N_DAY INT := -1 ;
N_HOUR INT := -1 ;
N_MIN INT := -1 ;
D_GAP FLOAT := -1 ;

BEGIN
	DT_DATE := TO_DATE(V_DATETIME,'YYYYMMDDHH24MISS') ;
	
	SELECT 
		 GAP INTO D_GAP
	FROM (
		SELECT sysdate - DT_DATE AS GAP FROM DUAL 
	) ;
	
	N_DAY := TRUNC(D_GAP) ;
	
	IF N_DAY < 0 THEN RETURN -1 ; END IF;

	IF (0<= N_DAY AND N_DAY < 1) THEN 
		N_HOUR := TRUNC(D_GAP*24) ;

		IF N_HOUR < 0 THEN RETURN -1 ; END IF ;

		IF (0 <= N_HOUR AND N_HOUR < 1) THEN
			N_MIN := TRUNC(D_GAP*24*60) ;
			IF N_MIN < 0 THEN RETURN -1 ; END IF ;
			
			RETURN N_MIN || '분 전' ;
		ELSE
			RETURN N_HOUR || '시간 전' ;
		END IF;

	ELSE
		IF(N_DAY >=3) THEN
			RETURN TO_CHAR(DT_DATE,'MM.DD HH:MI') ; 
		ELSE  
			IF (N_DAY=1) THEN RETURN '어제 ' || TO_CHAR(DT_DATE,'PM HH:MI') ; END IF ;
			IF (N_DAY=2) THEN RETURN '그제 ' || TO_CHAR(DT_DATE,'PM HH:MI') ; END IF ;
		END IF ;
	END IF;
		
	RETURN N_RETURN ;
END FN_TIMEGAP;


CREATE OR REPLACE PROCEDURE           PC_NOTIUPDATE 
  
IS   
    CURSOR cSor IS  
        SELECT N_IDX,N_OWNER_IDX, N_TBL_IDX, V_TBL_NM FROM TIMECLOUD_NOTIFICATION ;  -- 커서  

t_N_NOTI_IDX INT ;
t_N_OWNER_IDX INT;   
t_N_TBL_IDX INT ;
t_V_TBL_NM VARCHAR(30);

t_N_CREATOR_IDX INT;   

BEGIN  
    OPEN cSor;  
    LOOP  
        FETCH cSor INTO t_N_NOTI_IDX, t_N_OWNER_IDX, t_N_TBL_IDX, t_V_TBL_NM ;       -- 커서의 컬럼갯수와, 변수의 갯수가 일치해야 한다  
            EXIT WHEN cSor%NOTFOUND;  
            --DBMS_OUTPUT.PUT_LINE(N_OWNER_IDX || chr(9) || N_CREATOR_IDX || chr(9) || N_TBL_IDX || chr(9) || V_TBL_NM); 
            IF (t_V_TBL_NM = 'TIMECLOUD_FEEDBACK') THEN
				SELECT N_OWNER_IDX INTO t_N_CREATOR_IDX FROM TIMECLOUD_FEEDBACK WHERE N_IDX = t_N_TBL_IDX ; 
			ELSE
				IF (t_V_TBL_NM = 'TIMECLOUD_FILE') THEN
					SELECT N_OWNER_IDX INTO t_N_CREATOR_IDX FROM TIMECLOUD_FILE WHERE N_IDX = t_N_TBL_IDX ; 
				ELSE
					IF (t_V_TBL_NM = 'TIMECLOUD_ACTIVITY') THEN
						SELECT N_OWNER_IDX INTO t_N_CREATOR_IDX FROM TIMECLOUD_ACTIVITY WHERE N_IDX = t_N_TBL_IDX ; 
					ELSE				
						SELECT N_OWNER_IDX INTO t_N_CREATOR_IDX FROM TIMECLOUD_TASK WHERE N_IDX = t_N_TBL_IDX ; 
					END IF ;
				END IF ;
			END IF ;
			
			UPDATE TIMECLOUD_NOTIFICATION SET N_CREATOR_IDX = t_N_CREATOR_IDX WHERE N_IDX=t_N_NOTI_IDX ;
			
			commit ;
    END LOOP;  
      
    CLOSE cSor;  
END ;


